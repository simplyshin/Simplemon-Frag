# 复制为 .env 后填写（.env 已被 gitignore，不会提交）

# MCP/REST 端点鉴权 token（客户端请求需携带 Authorization: Bearer <token>）
AUTH_TOKEN=change-me-to-a-random-string

# 服务端口（也可由 data/config.json 的 server.port 配置，env 优先）
PORT=3210

# 文档写入后自动重建项目索引（默认开启）；多实例部署时设为 off 关闭
AUTO_REBUILD_INDEX=on

# ==== Provider API Keys（P2 起使用，按所选厂商填写）====
# 智谱
ZHIPU_API_KEY=
# OpenAI
OPENAI_API_KEY=
# Anthropic (Claude)
ANTHROPIC_API_KEY=
# DeepSeek
DEEPSEEK_API_KEY=
