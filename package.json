{
  "name": "frag-mcp-server",
  "version": "0.1.0",
  "description": "项目文档管理 MCP 服务 — 自托管项目知识库（文档检索/更新/归档）",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.4",
    "@fastify/static": "^8.3.0",
    "@modelcontextprotocol/sdk": "^1.18.0",
    "better-sqlite3": "^11.10.0",
    "fastembed": "^3.0.0",
    "fastify": "^5.3.0",
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5",
    "sqlite-vec": "^0.1.9",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.7"
  }
}
